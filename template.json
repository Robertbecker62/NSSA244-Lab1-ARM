{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "virtualMachines_WEB1_name": { "defaultValue": "WEB1", "type": "String" },
        "virtualMachines_WEB2_name": { "defaultValue": "WEB2", "type": "String" },
        "sshPublicKeys_WEB1_key_name": { "defaultValue": "WEB1_key", "type": "String" },
        "publicIPAddresses_WEB1_ip_name": { "defaultValue": "WEB1-ip", "type": "String" },
        "publicIPAddresses_WEB2_ip_name": { "defaultValue": "WEB2-ip", "type": "String" },
        "virtualNetworks_VNET1_LAB1_name": { "defaultValue": "VNET1-LAB1", "type": "String" },
        "networkInterfaces_web1_name": { "defaultValue": "web1127_z2", "type": "String" },
        "networkInterfaces_web2_name": { "defaultValue": "web1127_z2Act2", "type": "String" },
        "networkSecurityGroups_NSG_WEB1_name": { "defaultValue": "NSG-WEB1", "type": "String" }
    },
    "resources": [
        {
            "type": "Microsoft.Compute/sshPublicKeys",
            "apiVersion": "2024-11-01",
            "name": "[parameters('sshPublicKeys_WEB1_key_name')]",
            "location": "eastus2",
            "properties": { "publicKey": "ssh-rsa  generated-by-azure" }
        },
        {
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "2024-07-01",
            "name": "[parameters('networkSecurityGroups_NSG_WEB1_name')]",
            "location": "eastus2",
            "properties": {
                "securityRules": [
                    { "name": "ALLOW-SSH", "properties": { "protocol": "TCP", "sourcePortRange": "*", "destinationPortRange": "22", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*", "access": "Allow", "priority": 100, "direction": "Inbound" } },
                    { "name": "ALLOW-HTTP", "properties": { "protocol": "TCP", "sourcePortRange": "*", "destinationPortRange": "80", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*", "access": "Allow", "priority": 101, "direction": "Inbound" } }
                ]
            }
        },
        /* PUBLIC IPs: One for each server to maintain consistency */
        {
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "2024-07-01",
            "name": "[parameters('publicIPAddresses_WEB1_ip_name')]",
            "location": "eastus2",
            "sku": { "name": "Standard" },
            "zones": [ "2" ],
            "properties": { "publicIPAllocationMethod": "Static" }
        },
        {
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "2024-07-01",
            "name": "[parameters('publicIPAddresses_WEB2_ip_name')]",
            "location": "eastus2",
            "sku": { "name": "Standard" },
            "zones": [ "2" ],
            "properties": { "publicIPAllocationMethod": "Static" }
        },
        {
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "2024-07-01",
            "name": "[parameters('virtualNetworks_VNET1_LAB1_name')]",
            "location": "eastus2",
            "properties": {
                "addressSpace": { "addressPrefixes": [ "10.0.0.0/16" ] },
                "subnets": [ { "name": "SUBNET-WEB", "properties": { "addressPrefixes": [ "10.0.1.0/24" ] } } ]
            }
        },
        /* NIC 1: Reverted to existing name web1127_z2 */
        {
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "2024-07-01",
            "name": "[parameters('networkInterfaces_web1_name')]",
            "location": "eastus2",
            "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_WEB1_ip_name'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworks_VNET1_LAB1_name'))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_NSG_WEB1_name'))]"
            ],
            "properties": {
                "ipConfigurations": [ {
                    "name": "ipconfig1",
                    "properties": {
                        "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_WEB1_ip_name'))]" },
                        "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_VNET1_LAB1_name'), 'SUBNET-WEB')]" }
                    }
                } ],
                "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_NSG_WEB1_name'))]" }
            }
        },
        /* NIC 2: New dedicated NIC for WEB2 */
        {
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "2024-07-01",
            "name": "[parameters('networkInterfaces_web2_name')]",
            "location": "eastus2",
            "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_WEB2_ip_name'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworks_VNET1_LAB1_name'))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_NSG_WEB1_name'))]"
            ],
            "properties": {
                "ipConfigurations": [ {
                    "name": "ipconfig1",
                    "properties": {
                        "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_WEB2_ip_name'))]" },
                        "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_VNET1_LAB1_name'), 'SUBNET-WEB')]" }
                    }
                } ],
                "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_NSG_WEB1_name'))]" }
            }
        },
        /* VIRTUAL MACHINES */
        {
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "2024-11-01",
            "name": "[parameters('virtualMachines_WEB1_name')]",
            "location": "eastus2",
            "dependsOn": [ "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaces_web1_name'))]" ],
            "zones": [ "2" ],
            "properties": {
                "hardwareProfile": { "vmSize": "Standard_D2s_v3" },
                "storageProfile": {
                    "imageReference": { "publisher": "canonical", "offer": "ubuntu-24_04-lts", "sku": "server", "version": "latest" },
                    "osDisk": { "createOption": "FromImage", "managedDisk": { "storageAccountType": "Premium_LRS" } }
                },
                "osProfile": {
                    "computerName": "[parameters('virtualMachines_WEB1_name')]",
                    "adminUsername": "azureuser",
                    "linuxConfiguration": { "disablePasswordAuthentication": true, "ssh": { "publicKeys": [ { "path": "/home/azureuser/.ssh/authorized_keys", "keyData": "ssh-rsa  generated-by-azure" } ] } }
                },
                "networkProfile": { "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaces_web1_name'))]" } ] }
            }
        },
        {
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "2024-11-01",
            "name": "[parameters('virtualMachines_WEB2_name')]",
            "location": "eastus2",
            "dependsOn": [ "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaces_web2_name'))]" ],
            "zones": [ "2" ],
            "properties": {
                "hardwareProfile": { "vmSize": "Standard_D2s_v3" },
                "storageProfile": {
                    "imageReference": { "publisher": "canonical", "offer": "ubuntu-24_04-lts", "sku": "server", "version": "latest" },
                    "osDisk": { "createOption": "FromImage", "managedDisk": { "storageAccountType": "Premium_LRS" } }
                },
                "osProfile": {
                    "computerName": "[parameters('virtualMachines_WEB2_name')]",
                    "adminUsername": "azureuser",
                    "linuxConfiguration": { "disablePasswordAuthentication": true, "ssh": { "publicKeys": [ { "path": "/home/azureuser/.ssh/authorized_keys", "keyData": "ssh-rsa  generated-by-azure" } ] } }
                },
                "networkProfile": { "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaces_web2_name'))]" } ] }
            }
        }
    ]
}
